set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Export commands for clangd")
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR wasm64)
get_filename_component(sdk_prefix "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
list(PREPEND CMAKE_PREFIX_PATH "${CMAKE_CURRENT_LIST_DIR}" "${sdk_prefix}")
list(REMOVE_DUPLICATES CMAKE_PREFIX_PATH)

set(MODLOADER_TOOLCHAIN "${sdk_prefix}/bin" CACHE PATH "ModLoader compiler directory")
set(MODLOADER_SYSROOT "${CMAKE_CURRENT_LIST_DIR}/../sysroot" CACHE PATH "ModLoader headers and libraries")
cmake_path(ABSOLUTE_PATH MODLOADER_TOOLCHAIN NORMALIZE)
cmake_path(ABSOLUTE_PATH MODLOADER_SYSROOT NORMALIZE)
set(CMAKE_SYSROOT "${MODLOADER_SYSROOT}")
set(MODLOADER_PLATFORM n64 CACHE STRING "Module platform")
set(MODLOADER_TARGET wasm64-unknown-unknown)

if(CMAKE_HOST_WIN32)
    set(MODLOADER_EXECUTABLE_SUFFIX .exe)
else()
    set(MODLOADER_EXECUTABLE_SUFFIX "")
endif()
set(CMAKE_C_COMPILER "${MODLOADER_TOOLCHAIN}/clang${MODLOADER_EXECUTABLE_SUFFIX}")
set(CMAKE_CXX_COMPILER "${MODLOADER_TOOLCHAIN}/clang++${MODLOADER_EXECUTABLE_SUFFIX}")
set(CMAKE_C_COMPILER_TARGET ${MODLOADER_TARGET})
set(CMAKE_CXX_COMPILER_TARGET ${MODLOADER_TARGET})
set(CMAKE_AR "${MODLOADER_TOOLCHAIN}/llvm-ar${MODLOADER_EXECUTABLE_SUFFIX}")
set(CMAKE_RANLIB "${MODLOADER_TOOLCHAIN}/llvm-ranlib${MODLOADER_EXECUTABLE_SUFFIX}")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(MODLOADER_CXX_LANGUAGE_FLAGS "-fno-exceptions -fno-rtti" CACHE STRING "Module C++ flags")
set(CMAKE_C_FLAGS_INIT "-pthread -fwrapv -fno-strict-aliasing")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -fmodloader ${MODLOADER_CXX_LANGUAGE_FLAGS} -ftrivial-auto-var-init=zero")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES MODLOADER_TOOLCHAIN MODLOADER_SYSROOT MODLOADER_PLATFORM MODLOADER_CXX_LANGUAGE_FLAGS)

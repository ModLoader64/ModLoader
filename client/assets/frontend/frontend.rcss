body {
    width: 100%; height: 100%;
    font-family: Montserrat; font-size: 15dp; color: #eeeeee;
    background: #303130; decorator: linear-gradient(145deg, #3f3f3f, #1a1b1a);
    overflow: hidden;
}

div, p, h1 { display: block; }
svg { image-color: #c7c5c1; }
* { box-sizing: border-box; }
button { cursor: pointer; tab-index: auto; }
button:focus, input:focus, select:focus { border-color: var(--accent-bright); }
select { position: relative; z-index: 3; }
select:focus { z-index: 4; }
button.disabled { opacity: 0.45; pointer-events: none; tab-index: none; }
.header-stripe { position: absolute; z-index: 0; pointer-events: none; top: -70dp; width: 90dp; height: 190dp; transform: skewX(-38deg); }
.stripe-one { right: 420dp; background: var(--accent); }
.stripe-two { right: 357dp; background: var(--accent-secondary); }
.stripe-three { right: 310dp; width: 52dp; background: var(--accent-deep); }
.platform-control, .brand, .nav-item, .toolbar-field, .row-actions, .rom-folder-row { display: flex; align-items: center; }
.stripe-left-one { left: -16dp; top: -80dp; width: 68dp; background: var(--accent-secondary); }
.stripe-left-two { left: -36dp; top: -80dp; width: 52dp; background: var(--accent); }
.brand { position: absolute; z-index: 1; left: 24dp; top: 34dp; width: 190dp; height: 52dp; }
.brand svg { width: 55dp; }
.brand-mark { display: flex; align-items: flex-start; margin-left: 12dp; transform: translateY(5dp); font-family: Teko; font-size: 58dp; line-height: 1; font-weight: bold; color: transparent; letter-spacing: -0.5dp; font-effect: outline(3dp #ffffff), brand-gradient(var(--brand-top) var(--brand-bottom)); }
.brand-platform { margin: 1dp 0 0 -3dp; font-size: 34dp; }
.platform-control { position: absolute; z-index: 3; right: 24dp; top: 39dp; width: 250dp; height: 42dp; padding: 0 16dp; border: 1dp var(--accent); background: #303130; }
.adapter-icon { display: inline-block; width: 34dp; height: 34dp; flex-shrink: 0; margin-right: 8dp; vertical-align: middle; }
.adapter-icon svg { width: 100%; height: 100%; }
#adapter { width: 100%; height: 34dp; font-size: 17dp; font-weight: bold; background: #303130; }
#adapter selectvalue { display: flex; align-items: center; height: 34dp; }
.sidebar { position: absolute; top: 104dp; left: 0; width: 200dp; bottom: 0; overflow: hidden; }
.nav-item { position: relative; z-index: 1; width: 100%; height: 62dp; margin-bottom: 8dp; padding: 0 22dp; border: 1dp transparent; border-radius: 7dp; font-size: 21dp; font-weight: bold; }
.nav-item svg { width: 31dp; flex-shrink: 0; margin-right: 17dp; }
.nav-item.active { border-color: var(--accent); background: var(--accent-medium); decorator: linear-gradient(110deg, var(--accent), var(--accent-dark)); }
.nav-item:hover { background: var(--accent-muted); }
.nav-item.active:hover { background: var(--accent); }
.sidebar-watermark { position: absolute; z-index: 0; pointer-events: none; width: 350dp; left: -110dp; bottom: 75dp; opacity: 0.09; transform: rotate(-18deg); }
.panel-label { position: absolute; top: 84dp; left: 222dp; color: #c7c5c1; font-size: 14dp; letter-spacing: 1dp; }
.main-panel { position: absolute; top: 104dp; left: 200dp; right: 16dp; bottom: 16dp; border: 3dp #484848; border-radius: 14dp; background: #202020; decorator: linear-gradient(135deg, #2e2e2e, #131313); }
.page { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 36dp; overflow: auto; padding: 20dp; }
.page.active { display: block; }
.general-hero { display: flex; width: 100%; height: 300dp; padding-bottom: 18dp; border-bottom: 2dp #484848; }
#selected-game { width: 47%; margin-right: 5%; height: 100%; }
#selected-game .game-card { display: flex; flex-direction: column; width: 100%; height: 100%; }
#selected-game .cover { flex: 1; }
#selected-game .card-caption { flex-shrink: 0; padding: 9dp 12dp; font-size: 16dp; }
.launch-form { width: 48%; padding-top: 1dp; }
.secondary, .compact-select, .launch-form label, .toolbar-field label { font-weight: 600; }
.launch-form label { display: block; color: #a9a9a9; font-size: 10dp; letter-spacing: 1dp; margin-bottom: 5dp; }
.text-input { display: block; width: 100%; height: 35dp; padding: 7dp 10dp; border: 2dp #f1f1f1; border-radius: 7dp; background: #f4f4f4; color: #242424; margin-bottom: 8dp; font-size: 13dp; }
.text-input:disabled { background: #343434; border-color: #484848; color: #808080; cursor: unavailable; }
.text-input::selection, .search-input::selection { background: var(--accent); color: white; }
.form-pair { display: flex; }
.form-field { width: 49%; }
.form-field:first-child { margin-right: 2%; }
.launch-form .offline-label { color: #eeeeee; display: flex; align-items: center; justify-content: flex-end; font-size: 13dp; letter-spacing: 0; height: 33dp; margin: 0 0 9dp; }
.checkbox { display: inline-block; width: 24dp; height: 24dp; background: #222222; border: 2dp var(--accent); border-radius: 3dp; margin-left: 12dp; vertical-align: middle; cursor: pointer; }
.checkbox:checked { background: var(--accent); decorator: linear-gradient(135deg, var(--accent-bright), var(--accent-dark)); }
.launch-button { width: 100%; height: 50dp; border: 1dp var(--accent-bright); border-radius: 9dp; background: var(--accent); decorator: linear-gradient(110deg, var(--accent), var(--accent-medium)); font-size: 21dp; font-weight: bold; }
.launch-button:hover { decorator: linear-gradient(110deg, var(--accent-bright), var(--accent-medium)); }
.play-icon { margin-right: 10dp; font-size: 26dp; }
.section-heading, .page-heading, .setting-row, .rom-folders-header { display: flex; align-items: center; justify-content: space-between; }
.section-heading { margin: 12dp 0 10dp; height: 30dp; }
.section-heading > span { font-size: 20dp; font-weight: bold; border-bottom: 3dp var(--accent); padding-bottom: 8dp; }
.text-button { font-size: 10dp; color: #c7c5c1; letter-spacing: 1dp; }
.text-button:hover { color: #ffffff; }
#recent-games { display: flex; width: 100%; overflow-x: auto; padding-bottom: 8dp; }
.game-card { display: block; position: relative; z-index: 0; overflow: hidden; border: 1dp #747474; border-radius: 10dp; background: #050505; color: #ffffff; }
.game-card:hover { border-color: var(--accent-bright); }
.game-card.selected { border: 2dp var(--accent); }
.cover { width: 100%; background: #292929; }
.launch-button, .secondary.details-toggle, .window-button, .no-art { display: flex; align-items: center; justify-content: center; }
.no-art { background: #282828; decorator: linear-gradient(135deg, #353535, #1a1b1a); }
.no-art svg { width: 72dp; opacity: 0.48; }
#selected-game .no-art svg { width: 112dp; }
.card-caption { position: relative; padding: 10dp 11dp; font-size: 13dp; font-weight: bold; }
.game-meta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; margin-top: 5dp; color: #999999; font-size: 11dp; font-weight: normal; font-effect: outline(1dp #050505); }
.game-meta > span { white-space: nowrap; }
.game-meta > span:last-child { margin-left: auto; padding-left: 8dp; }
#recent-games .game-card { width: 23%; min-width: 155dp; flex-shrink: 0; margin-right: 13dp; }
#recent-games .cover { height: 80dp; }
#recent-games .card-caption { font-size: 11dp; min-height: 44dp; }
#games-page { overflow: hidden; padding: 0; }
#games-page.active { display: flex; flex-direction: column; }
#games-content { display: flex; flex: 1; overflow: hidden; }
#games-scroll { flex: 1; overflow: auto; padding: 16dp 18dp 8dp; }
.game-details { display: none; }
.details-visible .game-details { display: block; width: 31%; min-width: 244dp; flex-shrink: 0; overflow: auto; padding: 14dp; border-left: 1dp #484848; background: #1b1b1b; }
.secondary.details-toggle { width: 32dp; height: 32dp; padding: 6dp; margin: 0 8dp 0 0; flex-shrink: 0; }
.details-toggle svg { width: 20dp; height: 20dp; }
.preview-card { width: 100%; border-color: var(--accent); }
.preview-card .cover { height: 140dp; }
.preview-card .card-caption { line-height: 1.3; padding: 9dp; }
.game-file-details { padding: 10dp 2dp 0; }
.detail-label { display: block; color: #a4a4a4; font-size: 10dp; margin-bottom: 5dp; }
.detail-value { margin-bottom: 10dp; font-size: 10dp; line-height: 1.4; word-break: break-all; }
.preview-actions { display: flex; flex-wrap: wrap; }
.preview-actions .secondary { display: block; width: 48%; padding: 8dp 5dp; margin-bottom: 7dp; font-size: 10dp; text-align: center; }
.preview-actions .secondary:first-child { margin-right: 4%; }
.library-toolbar { position: relative; z-index: 2; display: flex; align-items: center; flex-shrink: 0; padding: 10dp 12dp; border-bottom: 1dp #686868; }
.toolbar-field { flex-shrink: 0; height: 32dp; margin-right: 10dp; }
.toolbar-field label { display: inline-block; color: #a4a4a4; font-size: 9dp; margin-right: 6dp; }
.compact-select { height: 32dp; min-width: 94dp; padding: 4dp 8dp; border: 1dp #484848; border-radius: 4dp; background: #292929; color: #dedede; font-size: 11dp; }
#sort { min-width: 152dp; }
selectvalue { padding-right: 25dp; }
selectarrow { width: 9dp; height: 5dp; margin-top: 9dp; margin-right: 2dp; border-top: 5dp #c7c5c1; border-left: 4dp transparent; border-right: 4dp transparent; }
selectbox { background: #252525; border: 1dp #606060; padding: 4dp; }
option { padding: 8dp 12dp; color: #dedede; }
option:hover, option:checked { background: var(--accent-medium); color: #ffffff; }
.search-input { flex: 1; min-width: 90dp; height: 32dp; margin: 0 8dp 0 0; padding: 8dp 10dp; background: #171717; border: 1dp #484848; border-radius: 4dp; font-size: 11dp; }
.secondary { display: inline-block; padding: 11dp 14dp; border: 1dp var(--accent); border-radius: 5dp; background: var(--accent-surface); font-size: 11dp; }
.secondary:hover { background: var(--accent-dark); }
.details-toggle.active { border-color: var(--accent-bright); background: var(--accent-dark); }
.browse-button { height: 32dp; padding: 8dp 10dp; flex-shrink: 0; }
.game-grid { display: flex; flex-wrap: wrap; align-content: flex-start; }
.game-grid.boxart { gap: 12dp; }
.game-grid .game-meta { display: block; line-height: 15dp; }
.game-grid .game-meta > span { display: block; }
.game-grid .game-meta > span:last-child { margin-left: 0; padding-left: 0; }
.game-grid.boxart .game-card { display: flex; flex-direction: column; flex-shrink: 0; width: var(--game-card-width, 100%); height: 268dp; }
.game-grid.boxart .cover { height: 155dp; flex-shrink: 0; }
.game-grid.boxart .card-caption { display: flex; flex-direction: column; flex: 1; overflow: hidden; padding: 8dp 10dp; line-height: 17dp; }
.game-grid.boxart .game-title { display: block; max-height: 51dp; overflow: hidden; }
.game-title { position: relative; z-index: 1; font-effect: outline(1dp #050505); }
.card-footer { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
.card-footer .game-meta { flex: 1; margin-top: 0; }
.card-footer > .logo-image { width: 70dp; height: 34dp; margin-left: 6dp; flex-shrink: 0; }
.game-grid.details { row-gap: 6dp; }
.game-grid.details .game-card, .game-grid.list .game-card { display: flex; align-items: center; width: 100%; border-radius: 5dp; }
.game-grid.details .game-card { height: 78dp; }
.game-grid.details .cover { width: 96dp; height: 100%; flex-shrink: 0; }
.game-grid.details .card-caption, .game-grid.list .card-caption { flex: 1; overflow: hidden; z-index: 1; }
.game-grid.details .card-caption { max-height: 76dp; padding: 6dp 10dp; line-height: 17dp; }
.game-grid.details .game-meta { margin-top: 2dp; font-size: 10dp; line-height: 14dp; }
.game-grid.list { row-gap: 5dp; }
.game-grid.list .game-card { height: 40dp; }
.game-grid.list .card-caption { max-height: 38dp; padding: 4dp 10dp; line-height: 16dp; }
.game-grid.details .game-card.selected, .game-grid.list .game-card.selected { border-width: 1dp; }
.game-logo { position: relative; z-index: 1; width: 110dp; height: 100%; padding: 4dp 8dp; flex-shrink: 0; }
.card-background { position: absolute; z-index: 0; left: 0; right: 0; top: 0; bottom: 0; display: flex; pointer-events: none; }
.card-gradient { flex: 1; decorator: linear-gradient(to right, #050505 50%, var(--accent-deep) 85%, var(--accent) 100%); }
.game-grid.details .card-background { left: 96dp; }
.logo-stripes { position: relative; width: 120dp; height: 100%; flex-shrink: 0; background: var(--accent); }
.logo-stripes > div { position: absolute; top: 0; height: 100%; transform: skewX(-38deg); transform-origin: 100% 100%; }
.logo-stripe-middle { left: 39%; width: 29%; background: var(--accent-secondary); }
.logo-stripe-dark { left: 68%; width: 100%; background: var(--accent-deep); }
.game-grid.boxart .logo-stripes { width: 112dp; }
.logo-image { position: relative; width: 100%; height: 100%; }
.logo-image.loaded { filter: drop-shadow(#00000055 0 1dp 1dp); }

.page-heading { margin-bottom: 27dp; padding-bottom: 22dp; border-bottom: 1dp #484848; }
h1 { font-size: 32dp; font-weight: bold; margin: 6dp 0 7dp; }
.muted { color: #a4a4a4; font-size: 13dp; line-height: 1.6; }
.setting-row { width: 100%; min-height: 86dp; padding: 17dp 19dp; margin-bottom: 12dp; background: #252525; border: 1dp #484848; border-radius: 7dp; }
.setting-info { flex: 1; padding-right: 20dp; }
.setting-title { font-size: 16dp; font-weight: bold; }
.setting-description { color: #a4a4a4; font-size: 12dp; margin-top: 6dp; line-height: 1.5; }
.setting-row .text-input, .setting-row .compact-select { width: 280dp; }
.setting-row .text-input { margin: 0; height: 36dp; font-size: 12dp; }
.row-actions .secondary, .rom-folder-row .secondary { margin-left: 10dp; }
.settings-title, .rom-folders-header { margin: 24dp 0 15dp; }
.settings-title, .rom-folders-header > span { font-size: 18dp; font-weight: bold; }
.rom-folder-row .text-input { flex: 1; width: auto; }
.rom-folder-row .secondary { flex-shrink: 0; }

.empty-state { width: 100%; padding: 34dp 25dp; border: 1dp #484848; border-radius: 10dp; background: #1c1c1c; text-align: center; }
#selected-game .empty-state { height: 100%; padding-top: 75dp; }
.empty-title { font-size: 22dp; font-weight: bold; margin-bottom: 12dp; }
.empty-state .secondary { margin-top: 22dp; }
.empty-state.compact { padding: 25dp; }
.status-bar { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; height: 36dp; display: flex; align-items: center; padding: 0 22dp; border-top: 1dp #383838; border-radius: 0 0 11dp 11dp; background: #181818; color: #969696; font-size: 10dp; }
.status-dot { width: 5dp; height: 5dp; border-radius: 3dp; background: var(--accent); margin-right: 9dp; }
.corner-accent { position: absolute; z-index: 1; right: -54dp; bottom: -34dp; width: 160dp; height: 35dp; background: var(--accent-medium); transform: rotate(-39deg); pointer-events: none; }
scrollbarvertical { width: 7dp; background: #191919; }
scrollbarhorizontal { height: 7dp; background: #191919; }
scrollbarvertical sliderbar, scrollbarhorizontal sliderbar { background: #555555; border-radius: 4dp; }
scrollbarvertical sliderbar:hover, scrollbarhorizontal sliderbar:hover { background: var(--accent-medium); }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0; }
.nav-item:focus, .game-card:focus, .secondary:focus, .launch-button:focus { border-color: #ffffff; }
.text-button:focus { color: #ffffff; text-decoration: underline; }

#config-page > .secondary { margin-bottom: 12dp; }
#window-drag { position: absolute; z-index: 4; left: 0; right: 0; top: 0; height: 32dp; }
#window-controls { position: absolute; z-index: 5; right: 0; top: 0; height: 28dp; display: flex; }
.window-button { width: 36dp; height: 28dp; padding: 7dp 11dp; }
.window-button svg { width: 14dp; height: 14dp; image-color: #dedede; pointer-events: none; }
.window-button:hover { background: #484848; }
.window-close:hover { background: var(--accent); }
.resize-grip { position: absolute; z-index: 4; right: 0; bottom: 0; width: 18dp; height: 18dp; }
.resize-grip svg { width: 18dp; height: 18dp; image-color: #aaaaaa; pointer-events: none; }
.native-chrome #window-drag, .native-chrome #window-controls, .native-chrome .resize-grip, .maximized .resize-grip { display: none; }

@media (max-width: 1050dp) {
    .nav-item svg { width: 28dp; }
    .panel-label { left: 226dp; }
    .general-hero { height: 290dp; padding-bottom: 16dp; }
    #selected-game { margin-right: 4%; width: 46%; }
    .launch-form { width: 50%; }
    .text-input { font-size: 12dp; padding: 7dp 9dp; }
    .launch-button { height: 54dp; }
    .launch-form .offline-label { height: 26dp; font-size: 11dp; }
    #selected-game .card-caption { font-size: 15dp; padding: 8dp 10dp; }
    #recent-games .game-card { min-width: 140dp; }
    .library-toolbar { padding: 10dp; }
    #games-scroll { padding: 12dp 14dp 8dp; }
    .compact-select { min-width: 88dp; }
    #sort { min-width: 146dp; }
    .game-grid.boxart .game-card { height: 238dp; }
    .game-grid.boxart .cover { height: 125dp; }
    .game-grid .card-caption { font-size: 11dp; }
    .setting-row .text-input, .setting-row .compact-select { width: 205dp; }
    .platform-control { width: 225dp; padding-left: 12dp; padding-right: 12dp; }
    .details-visible #games-scroll { padding: 15dp 12dp 8dp; }
    .details-visible .game-details { padding: 15dp 12dp; }
    .preview-card .cover { height: 120dp; }
    .game-logo { width: 90dp; }
    .logo-stripes { width: 100dp; }
    .game-grid.details .cover { width: 82dp; }
    .game-grid.details .card-background { left: 82dp; }
}
